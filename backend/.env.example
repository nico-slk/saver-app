# Copiar a .env (en esta carpeta) para docker compose y para el backend en local.
# NUNCA commitear .env

# Base de datos (PostgreSQL de docker compose)
# 5433 en el host porque el 5432 suele estar ocupado por un PostgreSQL instalado en Windows.
# Lo usan docker compose (puerto publicado), el backend (JDBC) y los tests de integración.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=saver
DB_USER=saver
DB_PASSWORD=saver

# JWT propio (mínimo 32 caracteres; en prod va en Secret Manager)
JWT_SECRET=change-me-please-this-must-be-at-least-32-chars-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google OAuth (Client ID de tipo "Aplicación web" en Google Cloud Console)
GOOGLE_CLIENT_ID=

# URL pública del frontend (links de los emails)
APP_WEB_URL=http://localhost:5173

# Emails: log (solo log) | mailpit (Docker, ver http://localhost:8025) | brevo (envío real gratuito)
MAIL_PROVIDER=mailpit
MAIL_FROM_ADDRESS=no-reply@saver.local
MAIL_FROM_NAME=Saver
MAIL_MAILPIT_URL=http://localhost:8025
# Solo para MAIL_PROVIDER=brevo: API key de https://app.brevo.com (SMTP & API → API Keys)
MAIL_BREVO_API_KEY=

# CORS / cookies
APP_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Object storage local S3-compatible (SeaweedFS en Docker). No son secretos de producción.
STORAGE_PROVIDER=s3-compatible
STORAGE_ENVIRONMENT=development
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_BUCKET=saver-dev-media
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=saver-dev
STORAGE_SECRET_KEY=saver-dev-secret
# Debe permanecer alineado con spring.servlet.multipart.max-file-size (10 MB).
STORAGE_MAX_FILE_SIZE_BYTES=10485760
